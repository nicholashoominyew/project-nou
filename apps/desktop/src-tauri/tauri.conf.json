{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOU",
  "version": "0.0.4",
  "identifier": "app.projectnou.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOU",
        "decorations": false,
        "width": 1240,
        "height": 820,
        "minWidth": 780,
        "minHeight": 560,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 https://nominatim.openstreetmap.org https://api.open-meteo.com; img-src 'self' data: blob:; frame-src blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
